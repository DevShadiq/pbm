1  |  <template><section class="page"><header><div><small>ACADEMIC CURRICULUM</small><h1>Subject Entry</h1><p>মূল, ঐচ্ছিক এবং চতুর্থ বিষয়; Written, MCQ, Practical ও Viva marks setup করুন।</p></div><RouterLink to="/exams/class-subjects">Class-wise Subjects</RouterLink></header><p v-if="msg" :class="kind">{{msg}}</p><div class="grid"><form @submit.prevent="save"><h2>নতুন বিষয়</h2><label>Subject Code<input v-model.trim="f.subject_code" required placeholder="BAN-101"/></label><label>Subject Name<input v-model.trim="f.subject_name" required placeholder="Bangla"/></label><label>Subject Type<select v-model="f.subject_type"><option value="MAIN">Main / Compulsory</option><option value="OPTIONAL">Optional</option><option value="FOURTH_SUBJECT">Fourth Subject</option></select></label><label>Full Marks<input v-model.number="f.full_marks" type="number" min="1" required/></label><label>Pass Marks<input v-model.number="f.pass_marks" type="number" min="0" required/></label><label>Written<input v-model.number="f.written_marks" type="number" min="0" required/></label><label>MCQ<input v-model.number="f.mcq_marks" type="number" min="0" required/></label><label>Practical<input v-model.number="f.practical_marks" type="number" min="0" required/></label><label>Viva<input v-model.number="f.viva_marks" type="number" min="0" required/></label><p class="total">Component Total: <b :class="{bad:total!==Number(f.full_marks)}">{{total}} / {{f.full_marks}}</b></p><button :disabled="total!==Number(f.full_marks)">Save Subject</button></form><article><h2>Curriculum checklist</h2><ul><li>Academic Level, Class, Group, Medium</li><li>Subject master and class-wise assignment</li><li>Compulsory / Optional / Fourth Subject rules</li><li>Full/pass marks and assessment components</li><li>Credit, period/week and teacher assignment</li><li>Exam routine, GPA rule and promotion rule</li></ul></article></div><article><h2>Existing subjects</h2><table><tr><th>Code</th><th>Subject</th><th>Type</th><th>Marks Distribution</th></tr><tr v-for="x in rows"><td>{{x.subject_code}}</td><td>{{x.subject_name}}</td><td>{{x.subject_type}}</td><td>W {{x.written_marks}} · MCQ {{x.mcq_marks}} · P {{x.practical_marks}} · V {{x.viva_marks}}</td></tr></table></article></section></template><script setup>import{computed,onMounted,reactive,ref}from'vue';import{RouterLink}from'vue-router';import api from'../../services/api';const rows=ref([]),msg=ref(''),kind=ref('success'),f=reactive({subject_code:'',subject_name:'',subject_type:'MAIN',full_marks:100,pass_marks:33,written_marks:100,mcq_marks:0,practical_marks:0,viva_marks:0});const total=computed(()=>Number(f.written_marks||0)+Number(f.mcq_marks||0)+Number(f.practical_marks||0)+Number(f.viva_marks||0));async function load(){rows.value=(await api.get('/exams/subjects')).data.data}async function save(){try{await api.post('/exams/subjects',f);msg.value='Subject saved successfully.';kind.value='success';Object.assign(f,{subject_code:'',subject_name:'',subject_type:'MAIN',full_marks:100,pass_marks:33,written_marks:100,mcq_marks:0,practical_marks:0,viva_marks:0});load()}catch(e){msg.value=e.response?.data?.message||'Save failed.';kind.value='error'}}onMounted(load)</script><style scoped>.page{display:grid;gap:18px}header,form,article{padding:22px;border:1px solid #e2e8f0;border-radius:18px;background:#fff}header{display:flex;justify-content:space-between;background:linear-gradient(135deg,#eff6ff,#fff)}small{color:#4f46e5;font-weight:900}h1{margin:6px 0;color:#172554}h2{margin-top:0}p{color:#64748b}a{color:#4338ca;font-weight:800;text-decoration:none}.grid{display:grid;grid-template-columns:2fr 1fr;gap:18px}form{display:grid;grid-template-columns:1fr 1fr;gap:12px}form h2,button,.total{grid-column:1/-1}label{display:grid;gap:5px;font-size:13px;font-weight:800}input,select{padding:9px;border:1px solid #cbd5e1;border-radius:8px;font:inherit}button{width:max-content;background:#4338ca;color:white;border:0;padding:10px 14px;border-radius:8px;font-weight:800}.ba