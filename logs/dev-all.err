1  |  <template><section class="page"><header><div><h1>Exam Routine & Seating</h1><p>Routine তৈরি, তারিখ পরিবর্তন এবং classroom-based seating plan।</p></div><div><button :disabled="!examId" @click="showGenerate=true">Generate Routine</button><button :disabled="!examId" @click="showReschedule=true">Reschedule</button><button :disabled="!examId" @click="seating">Generate Seating</button></div></header><p v-if="msg" :class="kind">{{msg}}</p><article><label>Exam<select v-model="examId" @change="loadAll"><option value="">Select exam</option><option v-for="x in exams" :value="x.exam_id">{{x.exam_name}} — {{x.class_name||'All'}}</option></select></label></article><article><h2>Routine</h2><table><tr><th>Subject</th><th>Date</th><th>Time</th><th>Room</th><th></th></tr><tr v-for="x in subjects"><td>{{x.subject_name}}</td><td>{{x.exam_date||'—'}}</td><td>{{x.start_time||'—'}} – {{x.end_time||'—'}}</td><td>{{x.room_no||'—'}}</td><td><button class="mini" @click="edit(x)">Edit</button></td></tr></table></article><article v-if="seats.length"><h2>Seating Plan</h2><table><tr><th>Room</th><th>Seat</th><th>Candidate</th><th>Student</th></tr><tr v-for="x in seats"><td>{{x.room_no}}</td><td>{{x.seat_no}}</td><td>{{x.candidate_no}}</td><td>{{x.full_name}}</td></tr></table></article><div v-if="showGenerate" class="backdrop"><form @submit.prevent="generate"><h2>Generate Routine</h2><input v-model="g.start_date" type="date" required/><input v-model="g.start_time" type="time" required/><input v-model.number="g.duration_minutes" type="number" min="15"/><label><input v-model="g.skip_friday" type="checkbox"/> শুক্রবার বাদ</label><button>Generate</button><button type="button" @click="showGenerate=false">Cancel</button></form></div><div v-if="showReschedule" class="backdrop"><form @submit.prevent="reschedule"><h2>Reschedule</h2><input v-model="r.from_date" type="date" required/><input v-model.number="r.shift_days" type="number" required placeholder="Days: +2 / -1"/><button>Save</button><button type="button" @click="showReschedule=false">Cancel</button></form></div><div v-if="editRow" class="backdrop"><form @submit.prevent="saveEdit"><h2>Edit Schedule</h2><input v-model="e.exam_date" type="date"/><input v-model="e.start_time" type="time"/><input v-model="e.end_time" type="time"/><input v-model="e.room_no" placeholder="Classroom / Room No"/><button>Update</button><button type="button" @click="editRow=null">Cancel</button></form></div></section></template><script setup>import{onMounted,reactive,ref}from'vue';import api from'../../services/api';const exams=ref([]),subjects=ref([]),seats=ref([]),examId=ref(''),showGenerate=ref(false),showReschedule=ref(false),editRow=ref(null),msg=ref(''),kind=ref('success'),g=reactive({start_date:new Date().toISOString().slice(0,10),start_time:'10:00',duration_minutes:180,skip_friday:true}),r=reactive({from_date:'',shift_days:1}),e=reactive({exam_date:'',start_time:'',end_time:'',room_no:''});const note=(x,k='success')=>{msg.value=x;kind.value=k};async function loadAll(){if(!examId.value)return;subjects.value=(await api.get(`/exams/exams/${examId.value}/subjects`)).data.data;seats.value=(await api.get(`/exams/exams/${examId.value}/seating`)).data.data}async function generate(){try{await api.post(`/exams/exams/${examId.value}/routine/generate`,g);showGenerate.value=false;note('Routine generated.');loadAll()}catch(x){note(x.response?.data?.message||'Failed.','error')}}async function reschedule(){try{await api.post(`/exams/exams/${examId.value}/routine/reschedule`,r);showReschedule.value=false;note('Routine rescheduled.');loadAll()}catch(x){note(x.response?.data?.message||'Failed.','error')}}function edit(x){editRow.value=x;Object.assign(e,{exam_date:'',start_time:String(x.start_time||'').slice(0,5),end_time:String(x.end_time||'').slice(0,5),room_no:x.room_no||''})}async function saveEdit(){try{await api.put(`/exams/exam-subjects/${editRow.value.exam_subject_id}`,{...editRow.value,...e});editRow.value=null;note('Schedule updated.');loadAll()}catch(x){note(x.response?.data?.message||'Failed.','error')}}async function seating(){try{const x=await api.post(`/exams/exams/${examId.value}/seating/generate`);note(`${x.data.data.assigned} candidates seated.`);loadAll()}catch(x){note(x.response?.data?.message||'Failed.','error')}}onMounted(async()=>{exams.value=(await api.get('/exams/exams')).data.data})</script><style scoped>.page{display:grid;gap:16px;padding:20px}header,article{padding:18px;border:1px solid #e2e8f0;border-radius:14px;background:#fff}header{display:flex;justify-content:space-between;align-items:center}h1,h2{margin-top:0}button{padding:8px 11px;border:0;border-radius:7px;background:#4338ca;color:#fff;font-weight:800;margin:3px}input,select{padding:9px;border:1px solid #cbd5e1;border-radius:7px;font:inherit}article label{display:grid;gap:5px;max-width:320px;font-size:12px;font-weight:800}table{width:100%;border-collapse:collapse}th,td{padding:10px;border-bottom:1px solid #e2e8f0;text-align:left;font-size:13px}.backdrop{position:fixed;inset:0;z-index:10;display:grid;place-items:center;background:#0f172a88}.backdrop form{display:grid;gap:11px;width:min(400px,calc(100% - 30px));padding:22px;border-radius:15px;background:white}.success,.error{padding:10px}.success{background:#dcfce7;color:#166534}.error{background:#fee2e2;color:#b91c1c}@media(max-width:700px){header{align-items:flex-start;flex-direction:column}}</style>
