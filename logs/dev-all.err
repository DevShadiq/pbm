1  |  <template><section class="page"><header><div><small>EXAM & RESULTS</small><h1>Exam Routine Generator</h1><p>কোন পরীক্ষা কোন তারিখে হবে—সেট করুন, অটো রুটিন তৈরি করুন, তারপর প্রয়োজন হলে পৃথকভাবে পরিবর্তন করুন।</p></div><RouterLink to="/exams/setup">Exam setup</RouterLink></header><p v-if="msg" :class="kind">{{msg}}</p><div class="grid"><form @submit.prevent="generate"><h2>Auto routine settings</h2><label>Exam<select v-model="examId" required @change="loadSubjects"><option value="">Select exam</option><option v-for="x in exams" :value="x.exam_id">{{x.exam_name}} — {{x.class_name||'All classes'}}</option></select></label><label>Start date<input v-model="f.start_date" type="date" required/></label><label>Start time<input v-model="f.start_time" type="time" required/></label><label>Exam duration (minutes)<input v-model.number="f.duration_minutes" type="number" min="15" required/></label><label class="check"><input v-model="f.skip_friday" type="checkbox"/> শুক্রবার বাদ দিন</label><button :disabled="!examId">Generate routine</button></form><article><h2>নিয়ম</h2><ul><li>সাবজেক্টের ক্রম অনুযায়ী প্রতিদিন একটি করে পরীক্ষা সেট হবে।</li><li>Friday বাদ দেওয়ার অপশন চালু থাকলে সেদিন পরীক্ষা হবে না।</li><li>সময়কাল থেকে End Time স্বয়ংক্রিয়ভাবে তৈরি হবে।</li><li>Generate করার পরে Exam Setup থেকে date/time/room পরিবর্তন করা যাবে।</li></ul></article></div><article><h2>Generated routine</h2><table><tr><th>#</th><th>Subject</th><th>Date</th><th>Time</th><th>Room</th></tr><tr v-for="(x,i) in subjects" :key="x.exam_subject_id"><td>{{i+1}}</td><td>{{x.subject_code}} — {{x.subject_name}}</td><td>{{date(x.exam_date)}}</td><td>{{x.start_time||'—'}} – {{x.end_time||'—'}}</td><td>{{x.room_no||'—'}}</td></tr><tr v-if="examId&&!subjects.length"><td colspan="5">এই পরীক্ষায় এখনো কোনো subject যোগ করা হয়নি।</td></tr></table></article></section></template><script setup>import{onMounted,reactive,ref}from'vue';import{RouterLink}from'vue-router';import api from'../../services/api';const exams=ref([]),subjects=ref([]),examId=ref(''),msg=ref(''),kind=ref('success'),f=reactive({start_date:new Date().toISOString().slice(0,10),start_time:'10:00',duration_minutes:180,skip_friday:true});const date=v=>v?new Intl.DateTimeFormat('en-GB',{day:'2-digit',month:'short',year:'numeric'}).format(new Date(`${String(v).slice(0,10)}T00:00:00`)):'—';async function loadSubjects(){if(examId.value)subjects.value=(await api.get(`/exams/exams/${examId.value}/subjects`)).data.data}async function generate(){try{const r=await api.post(`/exams/exams/${examId.value}/routine/generate`,f);msg.value=`${r.data.data.scheduled}টি বিষয়ের রুটিন তৈরি হয়েছে।`;kind.value='success';loadSubjects()}catch(e){msg.value=e.response?.data?.message||'Routine তৈরি করা যায়নি।';kind.value='error'}}onMounted(async()=>{try{exams.value=(await api.get('/exams/exams')).data.data}catch(e){msg.value='Exam list load হয়নি।';kind.value='error'}})</script><style scoped>.page{display:grid;gap:18px}header,form,article{padding:22px;border:1px solid #e2e8f0;border-radius:18px;background:#fff}header{display:flex;justify-content:space-between;background:linear-gradient(135deg,#eef2ff,#fff)}small{font-weight:900;color:#4f46e5;letter-spacing:.1em}h1{margin:6px 0;color:#172554}h2{margin-top:0}p,li{color:#64748b;line-height:1.5}a{color:#4338ca;font-weight:800;text-decoration:none}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}form{display:grid;grid-template-columns:1fr 1fr;gap:12px}form h2,button{grid-column:1/-1}label{display:grid;gap:5px;font-size:13px;font-weight:800}.check{display:flex;align-items:center;gap:8px;padding-top:18px}input,select{padding:9px;border:1px solid #cbd5e1;border-radius:8px;font:inherit}button{width:max-content;padding:10px 14px;background:#4338ca;color:#fff;border:0;border-radius:8px;font-weight:800}.success,.error{padding:10px;font-weight:800}.success{background:#dcfce7;color:#166534}.error{background:#fee2e2;color:#b91c1c}table{width:100%;border-collapse:collapse}th,td{padding:10px;border-bottom:1px solid #e2e8f0;text-align:left;font-size:13px}th{font-size:11px;color:#64748b;text-transform:uppercase}@media(max-width:800px){.grid,form{grid-template-columns:1fr}header{flex-direction:column}}</style>
