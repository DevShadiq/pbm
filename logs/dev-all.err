1  |  <template><section class="page"><header><div><small>EXAM & RESULTS</small><h1>Routine & Reschedule</h1><p>রুটিন তৈরি, পরিবর্তন ও পরীক্ষা পিছিয়ে দিন।</p></div><div><button @click="openGenerate" :disabled="!examId">Generate Routine</button><button class="secondary" @click="reschedule=true" :disabled="!examId">Reschedule</button></div></header><p v-if="msg" :class="kind">{{msg}}</p><article class="filter"><label>Exam<select v-model="examId" @change="load"><option value="">Select exam</option><option v-for="x in exams" :value="x.exam_id">{{x.exam_name}} — {{x.class_name||'All'}}</option></select></label></article><article><table><tr><th>#</th><th>Subject</th><th>Date</th><th>Time</th><th>Room</th><th></th></tr><tr v-for="(x,i) in subjects"><td>{{i+1}}</td><td>{{x.subject_code}} — {{x.subject_name}}</td><td>{{x.exam_date||'—'}}</td><td>{{x.start_time||'—'}} – {{x.end_time||'—'}}</td><td>{{x.room_no||'—'}}</td><td><button class="mini" @click="edit(x)">Edit</button></td></tr></table></article><div v-if="generate" class="backdrop" @click.self="generate=false"><form class="modal" @submit.prevent="runGenerate"><h2>Generate Routine</h2><label>Start Date<input v-model="g.start_date" type="date" required/></label><label>Start Time<input v-model="g.start_time" type="time" required/></label><label>Duration (minutes)<input v-model.number="g.duration_minutes" type="number" min="15"/></label><label><input v-model="g.skip_friday" type="checkbox"/> শুক্রবার বাদ দিন</label><button>Generate</button></form></div><div v-if="reschedule" class="backdrop" @click.self="reschedule=false"><form class="modal" @submit.prevent="runReschedule"><h2>Reschedule Routine</h2><p>নির্বাচিত তারিখ ও পরের সব পরীক্ষা একসঙ্গে সরবে।</p><label>From Date<input v-model="r.from_date" type="date" required/></label><label>Shift Days<input v-model.number="r.shift_days" type="number" required placeholder="যেমন: 2"/></label><button>Reschedule</button></form></div><div v-if="editing" class="backdrop" @click.self="editing=null"><form class="modal" @submit.prevent="saveEdit"><h2>Edit Exam Schedule</h2><label>Date<input v-model="e.exam_date" type="date"/></label><label>Start Time<input v-model="e.start_time" type="time"/></label><label>End Time<input v-model="e.end_time" type="time"/></label><label>Room<input v-model="e.room_no"/></label><button>Save Changes</button></form></div></section></template><script setup>import{onMounted,reactive,ref}from'vue';import api from'../../services/api';const exams=ref([]),subjects=ref([]),examId=ref(''),generate=ref(false),reschedule=ref(false),editing=ref(null),msg=ref(''),kind=ref('success'),g=reactive({start_date:new Date().toISOString().slice(0,10),start_time:'10:00',duration_minutes:180,skip_friday:true}),r=reactive({from_date:'',shift_days:1}),e=reactive({exam_date:'',start_time:'',end_time:'',room_no:''});const note=(x,k='success')=>{msg.value=x;kind.value=k};async function load(){if(examId.value)subjects.value=(await api.get(`/exams/exams/${examId.value}/subjects`)).data.data}function openGenerate(){generate.value=true}async function runGenerate(){try{await api.post(`/exams/exams/${examId.value}/routine/generate`,g);generate.value=false;note('Routine generated.');load()}catch(x){note(x.response?.data?.message||'Generate failed.','error')}}async function runReschedule(){try{const x=await api.post(`/exams/exams/${examId.value}/routine/reschedule`,r);reschedule.value=false;note(`${x.data.data.rescheduled}টি পরীক্ষা re-schedule হয়েছে।`);load()}catch(x){note(x.response?.data?.message||'Reschedule failed.','error')}}function edit(x){editing.value=x;Object.assign(e,{...x,exam_date:String(x.exam_date||'').replace(/(\d{2})-([A-Z]{3})-(\d{4})/,(_,d,m,y)=>`${y}-${['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'].indexOf(m)+1}`),start_time:String(x.start_time||'').slice(0,5),end_time:String(x.end_time||'').slice(0,5)})}async function saveEdit(){try{await api.put(`/exams/exam-subjects/${editing.value.exam_subject_id}`,{...edi